<!doctype html>
<html lang="es">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="menu.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
  <link rel="shortcut icon" href="img/por_defecto/icono.png" type="image/x-icon">

  <title>Centro Comercial - Yantzaza</title>

  <style>
    /* RESET TOTAL */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body { overflow-x: hidden; }

    /* HEADER PRIORIDAD MÁXIMA */
    header, .header, nav {
      position: relative;
      z-index: 9999 !important;
    }

    /* CONTENEDOR DEL BANNER */
    .hero-container {
      position: relative;
      width: 100%;
      height: 90vh; /* Altura controlada */
      overflow: hidden;
      background-color: #000;
    }

    /* CAPA DE TEXTO (ESQUINA Y CLICABLE) */
    .hero-text-box {
      position: absolute;
      z-index: 100;
      top: 40px;
      left: 30px;
      pointer-events: none; /* Deja pasar los clics al menú */
    }

    .hero-text-box h1 {
      color: white;
      font-family: 'Lucida Sans', sans-serif;
      font-size: calc(1.5rem + 2vw);
      line-height: 1.1;
      text-shadow: 2px 2px 10px rgba(0, 0, 0, 0.8), 0 0 5px rgba(0, 81, 135, 0.5);
    }

    .hero-text-box span {
      color: #FFD700;
      font-size: 0.7em;
      display: block;
      margin-top: 5px;
    }

    /* SLIDER DINÁMICO */
    .slider-frame {
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    .slider-frame ul {
      display: flex;
      padding: 0;
      width: 400%; /* 4 imágenes */
      height: 100%;
      list-style: none;
      /* Animación forzada aquí */
      animation: slide-animation 20s infinite alternate ease-in-out;
    }

    .slider-frame li {
      width: 100%;
      height: 100%;
    }

    .slider-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    /* DEFINICIÓN DE LA ANIMACIÓN */
    @keyframes slide-animation {
      0% { margin-left: 0; }
      20% { margin-left: 0; }
      25% { margin-left: -100%; }
      45% { margin-left: -100%; }
      50% { margin-left: -200%; }
      70% { margin-left: -200%; }
      75% { margin-left: -300%; }
      100% { margin-left: -300%; }
    }

    /* RESPONSIVO MÓVIL */
    @media (max-width: 768px) {
      .hero-container { height: 45vh; }
      .hero-text-box { top: 20px; left: 20px; }
      .hero-text-box h1 { font-size: 1.4rem; }
    }
  </style>
</head>

<body>

<%- include("./template/header.ejs")%>

<div class="hero-container">
  <div class="hero-text-box">
    <h1 class="animate__animated animate__fadeInLeft">
      CENTRO COMERCIAL <br>
      <span>CIUDAD YANTZAZA</span>
    </h1>
  </div>

  <div class="slider-frame">
    <ul>
      <li><img src="/img/por_defecto/slider1.jpg" alt="Img 1"></li>
      <li><img src="/img/por_defecto/slider2.jpg" alt="Img 2"></li>
      <li><img src="/img/por_defecto/slider3.jpg" alt="Img 3"></li>
      <li><img src="/img/por_defecto/slider4.jpg" alt="Img 4"></li>
    </ul>
  </div>
</div>

<%- include("./template/footer.ejs")%>

</body>
</html>