<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

<style>
  :root {
    --primary-blue: #005187;
    --accent-gold: #ffd700;
    --text-dark: #333;
    --glass-bg: rgba(255, 255, 255, 0.95);
    --segundary_blue: #d4e3ed;
  }

  /* Header corregido */
  .header {
    background: rgba(255, 255, 255, 0.85) !important;
    backdrop-filter: blur(15px) !important;
    -webkit-backdrop-filter: blur(15px) !important;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    padding: 0 3% !important;
    position: sticky !important;
    top: 0 !important;
    z-index: 1000 !important;
    box-shadow: 0 2px 15px rgba(0,0,0,0.1) !important;
    font-family: 'Poppins', sans-serif !important;
    min-height: 70px !important;  
    max-height: 70px !important;
    height: 90px !important;
    width: 100% !important;
    border: none !important;
  }

  .hLogo {
    display: flex !important;
    align-items: center !important;
    gap: 15px !important;
    flex-shrink: 0 !important;
  }

  .hLogo h2 { margin: 0 !important; }

  .hLogo h2 a {
    color: var(--primary-blue) !important;
    text-decoration: none !important;
    font-weight: 600 !important;
    font-size: 2.0rem !important;
    letter-spacing: 1px !important;
    background: transparent !important;
    height: 50px !important;
  }

  .logo-img {
    height: 50px !important;
    transition: transform 0.3s;
  }

  
  .men {
    margin-left: center !important;
    flex-shrink: 6 !important;
    margin-right: 20% !important; 
  }

  .men ul {
    list-style: none !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    margin: 0 !important;
    padding: 0 !important;
    gap: 7px !important;
    margin-top: 0px !important;
    height: 70px !important;
  }

  .aButton {
    text-decoration: none !important;
    color: var(--text-dark) !important;
    font-weight: 400 !important;
    padding: 10px 15px !important;
    transition: all 0.3s !important;
    cursor: pointer !important;
    border-radius: 5px !important;
    background: transparent !important; 
    border: none !important;
    font-size: 1.5rem !important;
    white-space: nowrap !important;
  }

  .aButton:hover {
    color: var(--primary-blue) !important;
    background: rgba(0, 81, 135, 0.05) !important;
  }

  /* Menú Desplegable */
  .desp { 
    position: relative !important;
  }

  .as {
    display: none;
    flex-direction: column;
    position: absolute;
    top: 120%;
    right: 0;
    background: rgb(255, 255, 255) !important;
    min-width: 250px;
    border-radius: 12px !important;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
    border: 1px solid #eee !important;
    animation: slideDown 0.3s ease-out;
    z-index: 1100 !important;
  }

  .as.visible-flex { 
    display: flex !important; 
  }

  .as a {
    padding: 12px 20px !important;
    text-decoration: none !important;
    color: var(--text-dark) !important;
    font-size: 0.9rem !important;
    border-bottom: 1px solid #f9f9f9 !important;
    transition: 0.2s !important;
    background: white !important;
  }

  .as a:hover {
    background: var(--primary-blue) !important;
    color: white !important;
    padding-left: 25px !important;
  }

  /* Mobile */
  .menub, .menuc {
    display: none;
    background: none !important;
    border: none !important;
    font-size: 1.8rem !important;
    color: var(--primary-blue) !important;
    cursor: pointer !important;
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .header {
      padding: 0 4% !important; /* Más padding en móvil */
    }

    .menub { 
      display: block !important;
      margin-left: auto !important;
    }
    
    .men {
      position: fixed !important;
      top: 0;
      right: -100%;
      width: 80% !important;
      height: 100vh !important;
      background: white !important;
      transition: 0.4s;
      padding: 50px 20px !important;
      box-shadow: -5px 0 15px rgba(0,0,0,0.1) !important;
      z-index: 2000 !important;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }
    
    .men.visible { 
      right: 0 !important; 
    }
    
    .menuc { 
      display: block !important; 
      position: absolute; 
      top: 20px; 
      right: 20px; 
    }
    
    .men ul { 
      flex-direction: column !important; 
      align-items: flex-start !important;
      justify-content: flex-start !important;
    }
    
    .as { 
      position: static !important; 
      box-shadow: none !important; 
      border: none !important; 
      width: 100% !important; 
    }
  }
</style>

<header class="header">
  <div class="hLogo">
    <img src="/img/por_defecto/icono.png" alt="Logo" class="logo-img">
    <h2><a href="/">CENTRO COMERCIAL</a></h2>
  </div>

  <button id="abrir" class="menub">☰</button>

  <nav id="men" class="men">
    <button id="cerrar" class="menuc">✖</button>
    <ul>
      <li><a class="aButton" href="/">INICIO</a></li>
      <li id="btn-md" class="desp">
        <a class="aButton">LOCALES <small>▼</small></a>
        <div id="dropdown-locales" class="as">
          <a href="/zona-abarrotes">Abarrotes y Bazar</a>
          <!-- <a href="/zona-batidos">Jugos y Batidos</a> -->
          <a href="/zona-cafeteria">Cafetería</a>
          <!-- <a href="/zona-carnes">Carnes y Frigoríficos</a> -->
          <!-- <a href="/zona-comedores">Comedores</a> -->
          <a href="/zona-externos">Locales Externos</a>
          <a href="/zona-frutas">Frutas</a>
          <a href="/zona-islas">Islas</a>
          <!-- <a href="/zona-montes">Montes de Horchata</a> -->
          <a href="/zona-productos_zona">Productos de la Zona</a>
          <a href="/zona-ropa">Ropa</a>
          <a href="/zona-verdura">Verduras</a>
        </div>
      </li>
    </ul>
  </nav>
</header>

<script>
  (function() {
    const nav = document.querySelector("#men");
    const abrir = document.querySelector("#abrir");
    const cerrar = document.querySelector("#cerrar");
    const btnLocales = document.querySelector("#btn-md");
    const dropdown = document.querySelector("#dropdown-locales");

    if(abrir && cerrar) {
      abrir.onclick = () => nav.classList.add("visible");
      cerrar.onclick = () => nav.classList.remove("visible");
    }

    if(btnLocales) {
      btnLocales.onclick = (e) => {
        e.stopPropagation();
        dropdown.classList.toggle("visible-flex");
      };
    }

    document.onclick = (e) => {
      if (dropdown && !btnLocales.contains(e.target)) {
        dropdown.classList.remove("visible-flex");
      }
    };
  })();
</script>
